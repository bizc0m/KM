    "stableOutput": "search-v1.11.html",
    "shareOutputDir": "public",
    "defaultSort": "date",
    "defaultFolder": "all",
    "defaultTheme": "all",
    "stats": [
      "total",
      "watch",
      "resources",
      "red",
      "sensitive",
      "verify"
