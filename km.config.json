{
  "project": {
    "name": "KM Search",
    "version": "1.12",
    "description": "Recherche, veille, fiches Markdown et vues partageables par theme."
  },
  "sources": {
    "raindropPublicPage": "https://arno-vltn.raindrop.page/km-monitor-71629567",
